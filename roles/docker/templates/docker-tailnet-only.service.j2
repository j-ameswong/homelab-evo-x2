# Managed by Ansible.
# Ports are published on the Tailscale address, but a LAN host could still route
# packets for it via this machine's LAN IP. Drop anything for that address that
# did not arrive over tailscale0. --ctorigdst matches the address before Docker's DNAT.
[Unit]
Description=Allow only tailnet traffic to ports published on {{ bind_address }}
After=docker.service
BindsTo=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER {{ docker_tailnet_rule }} 2>/dev/null || iptables -I DOCKER-USER {{ docker_tailnet_rule }}'
ExecStop=-/usr/sbin/iptables -D DOCKER-USER {{ docker_tailnet_rule }}

[Install]
WantedBy=docker.service
